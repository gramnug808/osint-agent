# .env.example — copy to .env and fill in ONLY what you have.
# Never commit a real .env, never paste keys into chat.
# No key is required to run the agent in dry-run / no-model mode.

# Breach APIs (optional, lawful APIs only). Missing = skipped_no_key.
# HIBP_API_KEY=
# DEHASHED_EMAIL=
# DEHASHED_API_KEY=

# OpenAI-compatible local endpoint only (LM Studio etc.) — no cloud key.
# LOCAL_LLM_API_KEY=
